DATABASE_URL=postgres://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/ding
COOKIE_SECRET=CHANGE_ME
EMAIL_TOKEN_SECRET=CHANGE_ME
KEY_WRAP_SECRET=CHANGE_ME
# checkmark trust root. DING_ORG_PK renders the badge; DING_ORG_SK (org's private JWK) is
# signed by the in-server Deno.cron (only registers on Deno Deploy). SIMPLE path for now:
# the cron lives on the main server — move it to a separate project to harden later.
DING_ORG_PK=
DING_ORG_SK=
DING_DB=https://db.ding.bar
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com
STRIPE_SECRET_KEY=YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_SECRET_KEY
